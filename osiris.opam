opam-version: "2.0"
maintainer: ["François Pottier" "Armaël Guéneau" "Arnaud Daby-Seesaram"]
authors: ["François Pottier" "Armaël Guéneau" "Arnaud Daby-Seesaram"]
depends: [
  "ocaml"
  "dune" {>= "3.8"}
  "pprint"
  "compiler-libs"
  "coq-stdpp"
  "coq-iris"
  "coq-serapi"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
