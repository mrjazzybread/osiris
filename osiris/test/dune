; test_todo: TODO outcomes are recorded as <skipped>, not failures, so the
; binary now exits 0 on TODO and only non-zero on real (or XPASS) failures.
(test
  (name test_todo)
  (modules test_todo)
  (libraries ocaml-compiler-libs.common translatorlib junit)
  (action (setenv JUNIT_OUT %{project_root}/junit-todo.xml
    (run %{test}
      %{dep:sample_labeled.cmt}
      %{dep:sample_downto.cmt}
      %{dep:sample_opaque.cmt}
      %{dep:sample_shallow.cmt}
      %{dep:sample_pointfree.cmt})))
)

