; Shared test helper: tiny JUnit XML emitter consumed by GitLab's test reports.
; Each test executable depends on it and writes its results to $JUNIT_OUT.
(library
  (name junit)
  (modules junit)
  (wrapped false))

(rule
  (targets Fixture.cmt Fixture.cmo Fixture.cmi)
  (deps Fixture.ml)
  (action (run ocamlc -bin-annot -c %{deps}))
)

(rule
  (targets FixtureA.cmt FixtureA.cmo FixtureA.cmi)
  (deps FixtureA.ml)
  (action (run ocamlc -bin-annot -c %{deps}))
)

; FixtureB depends on FixtureA.cmi, which is in the same build directory.
; ocamlc searches the current directory by default, so no explicit -I is needed.
(rule
  (targets FixtureB.cmt FixtureB.cmo FixtureB.cmi)
  (deps FixtureB.ml FixtureA.cmi)
  (action (run ocamlc -bin-annot -c %{dep:FixtureB.ml}))
)

(test
  (name test_read_env)
  (modules test_read_env)
  (libraries ocaml-compiler-libs.common junit)
  (action (setenv JUNIT_OUT %{project_root}/junit-read_env.xml
    (run %{test} %{dep:Fixture.cmt} %{dep:FixtureA.cmt} %{dep:FixtureB.cmt})))
)

