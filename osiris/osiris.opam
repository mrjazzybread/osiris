opam-version: "2.0"
synopsis: "Osiris translates OCaml to Rocq for verification"
maintainer: ["François Pottier"]
authors: ["François Pottier" "Arnaud Daby-Seesaram" "Remy Seassau"]
homepage: "https://gitlab.inria.fr/fpottier/osiris/"
bug-reports: "francois.pottier@inria.fr"
depends: [
  "ocaml"
  "dune" {>= "3.8"}
  "ocaml-compiler-libs" {>= "5.3.0"}
  "pprint"
  "base"
  "ppx_sexp_conv"
  "ppx_deriving"
  "csexp"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
