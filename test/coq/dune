(include_subdirs qualified)
(coq.theory
  (package osiris)
  (theories osiris osiris.libs)
  (name test))

(rule
  (targets incr.v)
  (mode promote)
  (deps    (:gen ../../translator/bin/main.exe)
           (:src ../ml/incr.ml))
  (action
    (progn
       (run %{gen} -mode ml -ml %{src} -root ../../../.. -out %{targets}))))

