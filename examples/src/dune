;; Do not include this directory as part of this Coq project.
(include_subdirs no)

;; Compile these OCaml source files.
(library
  (flags (:standard -bin-annot))
  (name RocqOsirisExamples)
  ;; [proph] provides the [Proph] module, whose constructs the translator
  ;; recognizes; it is shipped with the translator, under [osiris/lib].
  (libraries osiris.proph)
)

(alias
  (name default)
  (deps RocqOsirisExamples.cma)
)
